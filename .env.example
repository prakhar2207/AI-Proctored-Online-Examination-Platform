# Hugging Face Serverless Inference API Token (strongly recommended to avoid local OOM failures)
HF_API_TOKEN=your_hugging_face_hub_token_here

# Enable local execution of Hugging Face models using transformers pipeline (requires PyTorch & RAM)
USE_LOCAL_HF_MODELS=False

# API endpoint references
NEXT_PUBLIC_API_URL=http://localhost:8000/api
